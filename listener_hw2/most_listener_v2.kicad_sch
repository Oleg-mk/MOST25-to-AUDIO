(text "J2 SD0/SD1: the frame's bytes 0..31 / 32..63, a TDM frame = a MOST frame." (exclude_from_sim no) (at 213.36 252.73 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0ca146a0-a688-568d-93fd-11fa1eb75572"))
