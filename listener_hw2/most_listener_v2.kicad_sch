(text "MCLK on J2 and J3 from separate FPGA pins, no branch." (exclude_from_sim no) (at 213.36 271.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0a194cac-0c28-5217-919f-2d42678d569a"))
