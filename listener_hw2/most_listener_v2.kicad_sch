(text "J3: I2S, BCLK 64 Fs, 32-bit slots, 24 bits with the head unit's controls applied; the same on S/PDIF, J6, J7 (block 9)." (exclude_from_sim no) (at 213.36 260.35 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5cd26d9a-9613-5d3b-a8cb-92907139f1c6"))
(text "J2 and J3 take no input: the one host is M2 (block 8)." (exclude_from_sim no) (at 213.36 264.16 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ae1955d8-8407-5a34-9ef6-35f1ce361963"))
