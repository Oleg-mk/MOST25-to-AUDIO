# python
__pycache__/
*.py[cod]

# gateware: Gowin build and simulation outputs
listener_gw/board/impl/
listener_gw/board/*.gprj*
listener_gw/sim/work/

# schematic: KiCad's local UI state, backups and locks, and the ERC report
# check_all.py rewrites (with the date) on every run
listener_hw/*.kicad_prl
listener_hw/*-backups/
listener_hw/~*.lck
listener_hw/fp-info-cache
listener_hw/erc.rpt
# board: gen_listener_pcb.py's netlist, DRC report and Specctra export; the routed session
listener_hw/work/

# firmware: listener_fw/.gitignore (ESP-IDF build, fetched components, tests)
